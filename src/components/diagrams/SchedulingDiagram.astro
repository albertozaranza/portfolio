---
const before = ["Usuário", "Liga para o suporte", "Atendente trata a solicitação", "Confirmação"];
const after = ["Usuário", "Fluxo self-service no app", "Confirmação"];
---

<figure class="sd" role="img" aria-label="Esquema: antes, o agendamento exigia uma ligação para o suporte; depois, o usuário conclui tudo em um fluxo self-service no app.">
  <div class="sd__lane">
    <p class="label sd__tag">Antes</p>
    <ol class="sd__flow">
      {
        before.map((s, i) => (
          <li class:list={["node", (i === 1 || i === 2) && "node--human"]} style={`--i:${i}`}>
            {s}
          </li>
        ))
      }
    </ol>
  </div>
  <div class="sd__lane sd__lane--after">
    <p class="label sd__tag">Depois</p>
    <ol class="sd__flow">
      {
        after.map((s, i) => (
          <li class:list={["node", i === 1 && "node--app"]} style={`--i:${i + 4}`}>
            {s}
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption class="label sd__cap">
    <span><i class="key key--human"></i> depende do time de suporte</span>
    <span><i class="key key--app"></i> self-service</span>
    <span>Esquemático</span>
  </figcaption>
</figure>

<style>
  .sd {
    display: grid;
    gap: 28px;
    padding: clamp(20px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .sd__lane {
    display: grid;
    grid-template-columns: 80px 1fr;
    align-items: center;
    gap: 16px;
  }

  .sd__flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 10px;
  }

  .node {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: 0.88rem;
    white-space: nowrap;
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: calc(var(--i) * 90ms + 200ms);
  }

  .node + .node {
    margin-left: 28px;
  }

  .node + .node::before {
    content: "";
    position: absolute;
    right: 100%;
    width: 28px;
    height: 1px;
    background: var(--line-strong);
  }

  .node--human {
    box-shadow: inset 0 0 0 1px var(--line-strong);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      color-mix(in srgb, var(--ink) 7%, transparent) 6px 7px
    );
  }

  .node--app {
    background: var(--signal);
    color: var(--on-signal);
    box-shadow: none;
    font-weight: 500;
  }

  :global(.js) :global(.case:not(.is-in)) .node {
    opacity: 0;
    transform: translateX(-12px);
  }

  .sd__cap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .sd__cap span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .sd__cap span:last-child {
    margin-left: auto;
  }

  .key {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .key--human {
    background-image: repeating-linear-gradient(-45deg, transparent 0 3px, var(--ink-3) 3px 4px);
  }

  .key--app {
    background: var(--signal);
    box-shadow: none;
  }

  @media (max-width: 699px) {
    .sd__lane {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .sd__flow {
      flex-direction: column;
      align-items: flex-start;
    }

    .node {
      white-space: normal;
    }

    .node + .node {
      margin-left: 0;
      margin-top: 14px;
    }

    .node + .node::before {
      right: auto;
      left: 20px;
      bottom: 100%;
      width: 1px;
      height: 14px;
    }

    .sd__cap span:last-child {
      margin-left: 0;
    }
  }
</style>
