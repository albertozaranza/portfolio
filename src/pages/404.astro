---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Página não encontrada · Alberto Zaranza" noindex>
  <main id="main" class="nf container">
    <p class="label">Erro 404</p>
    <h1 class="nf__title">Esta tela <span class="serif signal">não está no build.</span></h1>
    <p class="nf__text">A página que você procura não existe ou mudou de lugar.</p>
    <a class="btn" href={base}>Voltar ao portfolio</a>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 28px;
  }

  .nf__title {
    font-size: var(--step-4);
    max-width: 14ch;
  }

  .nf__text {
    color: var(--ink-2);
    font-size: var(--step-1);
  }
</style>
